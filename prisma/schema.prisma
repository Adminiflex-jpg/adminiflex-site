// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====== ADMIN GEBRUIKER (jijzelf, met 2FA) ======

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  role           String   @default("user")
  totpEnabled    Boolean  @default(true)
  totpSecret     String?          // Base32 secret voor Microsoft Authenticator
  recoveryHashes String[] @default([]) // gehashte herstelcodes (optioneel)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ====== AANVRAAG / ONBOARDING ======

model Application {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  status       ApplicationStatus @default(PENDING) // PENDING | SENT_FOR_SIGNATURE | SIGNED | REJECTED

  // aangevraagde gegevens
  companyName  String
  contactName  String
  address      String
  postalCode   String
  city         String
  email        String
  kvk          String
  btw          String
  plan         PlanCode // BASIC | PLUS | PRO

  // wanneer je het naar e-sign verstuurt
  contract     Contract?
  notes        String?   // interne notities
}

enum ApplicationStatus {
  PENDING
  SENT_FOR_SIGNATURE
  SIGNED
  REJECTED
}

enum PlanCode {
  BASIC
  PLUS
  PRO
}

// ====== KLANT / OMGEVING (TENANT) ======

enum PortalRole {
  SUPER_USER
  ADMIN_MEDEWERKER
  CONTROLLER
  ACCOUNTANT
}

// Gebruiker die inlogt in de KLANT-omgeving (niet jouw Admin-login)
model PortalUser {
  id          String      @id @default(cuid())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])

  email       String      @unique       // 👈 deze regel aanpassen!
  passwordHash String

  role        PortalRole  @default(ADMIN_MEDEWERKER)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([customerId, email])
}

// ====== CONTRACTEN / FACTUREN ======

model Contract {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  status         ContractStatus @default(DRAFT) // DRAFT | SENT | SIGNED

  applicationId  String?  @unique
  application    Application? @relation(fields: [applicationId], references: [id])

  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])

  version        Int       @default(1)
  html           String    // bewerkbare HTML (concept)
  pdfUrl         String?   // (na ondertekening, opslaglink, bv. Supabase Storage)
  signExternalId String?   // id bij e-sign provider
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
}

model Invoice {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  number      String   @unique

  // heel belangrijk: elke factuur hoort bij één Customer (tenant)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])

  amountCents Int
  status      String   // SENT | PAID | OVERDUE ...
}
model Customer {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  number        String    @unique
  companyName   String
  contactName   String
  address       String
  postalCode    String
  city          String
  email         String
  kvk           String
  btw           String
  plan          PlanCode

  // ✅ klantstatus
  isActive      Boolean   @default(false)

  // Nieuw voor demo-omgevingen
  demoActive    Boolean   @default(false)
  demoExpiresAt DateTime?

  // relaties
  contracts     Contract[]
  invoices      Invoice[]
  portalUsers   PortalUser[]
}
model ContactMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  email     String
  subject   String?
  message   String
}
model ContactTicket {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN")  // OPEN, BEZIG, AFGEHANDELD
  source    String?                    // bijv. "CONTACT_FORM"
}
